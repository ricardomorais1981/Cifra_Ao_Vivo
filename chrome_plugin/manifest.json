{
  "manifest_version": 3,
  "name": "Cifra ao Vivo \u2014 Captura da aba",
  "version": "1.0.0",
  "description": "Grava o \u00e1udio da aba do Chrome e envia para o Cifra ao Vivo (rodando no seu computador) gerar a cifra.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cifra ao Vivo"
  }
}
